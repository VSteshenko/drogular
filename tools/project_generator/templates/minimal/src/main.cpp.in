#include "components/home_component.hpp"
#include "home_page.hpp"

#include <drogular/app.hpp>

int main()
{
    drogular::App app;

    app.templateRoot("templates");
    app.staticFiles("/assets", "public");

    app.component<HomeComponent>();
    app.page<HomePage>("/");

    app.run(8080);

    return 0;
}
