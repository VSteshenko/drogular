# docker build -f Dockerfile.test -t drogular-tests .
# docker run --rm drogular-tests
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        git \
        ninja-build \
        pkg-config \
        libjsoncpp-dev \
        uuid-dev \
        zlib1g-dev \
        libssl-dev \
        libssh-dev \
        libpq-dev \
        libsqlite3-dev \
        libmariadb-dev \
        libbrotli-dev \
        libhiredis-dev \
        libyaml-cpp-dev \
        libc-ares-dev \
    && rm -rf /var/lib/apt/lists/*

# Ubuntu 24.04 ships Drogon 1.8.7, which lacks async SSE streaming.
# Pin the same newer API surface across platforms.
ARG DROGON_VERSION=v1.9.14
RUN git clone --depth 1 --branch "${DROGON_VERSION}" --recurse-submodules \
        https://github.com/drogonframework/drogon.git /tmp/drogon \
    && cmake -S /tmp/drogon -B /tmp/drogon-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_CTL=OFF \
        -DBUILD_ORM=OFF \
        -DBUILD_TESTING=OFF \
    && cmake --build /tmp/drogon-build --parallel 2 \
    && cmake --install /tmp/drogon-build \
    && ldconfig \
    && rm -rf /tmp/drogon /tmp/drogon-build

WORKDIR /workspace

CMD ["bash", "-lc", "cmake -S /workspace -B /tmp/drogular-build -G Ninja -DCMAKE_BUILD_TYPE=Debug -DDROGULAR_BUILD_TESTS=ON -DDROGULAR_BUILD_EXAMPLES=ON && cmake --build /tmp/drogular-build --parallel && ctest --test-dir /tmp/drogular-build --output-on-failure"]
